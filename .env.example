# Django Security Settings
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Master Key Encryption Key (KEK) - 256-bit Hex Encoded (64 chars)
# Used to wrap individual file Data Encryption Keys (DEKs)
MASTER_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database Configuration (MySQL 8.x recommended, sqlite3 fallback supported)
DB_ENGINE=mysql
DB_NAME=secure_file_sharing
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Storage and Limits
MAX_UPLOAD_SIZE_MB=50
PRIVATE_STORAGE_DIR=private_storage
